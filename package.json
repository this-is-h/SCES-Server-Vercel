{
  "name": "sces-server-vercel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nuxt build",
    "build:vercel": "nuxt build --preset vercel",
    "check:built-api": "node scripts/check-built-api.mjs",
    "check:environment": "node scripts/inspect-environment.mjs",
    "check:staging": "node scripts/verify-staging.mjs --execute",
    "prepare": "husky",
    "commitlint": "commitlint --from origin/develop..HEAD",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "verify": "pnpm type-check && pnpm check:contracts && pnpm test"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.1",
    "ajv": "^8.20.0",
    "h3": "^1.15.11",
    "hono": "^4.9.0",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.9",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.0",
    "vercel": "^59.15.1",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "archiver-utils>glob": "^10.5.0"
    }
  }
}
