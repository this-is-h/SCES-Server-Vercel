# Supabase Postgres 连接串（Supavisor 事务池，TLS 必开）
# 控制台：Project Settings → Database → Connection string → Transaction pooler
# 形如：postgres://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# 事务池模式下 postgres.js 必须 prepare: false（脚本已设）。
DATABASE_URL=

# 独立验收库；check:staging 比对本地及 Vercel 生产项目身份后才允许写入。
# 绝不能配置成生产项目；首次运行会迁移并保留标准种子，临时验收数据会清理。
STAGING_DATABASE_URL=

# 后台 access token 的 HMAC 签名密钥（生成：openssl rand -hex 32）
TOKEN_SIGNING_SECRET=

# 超管初始口令（首登强制改密；生产环境经 Vercel Project Environment 注入）
ADMIN_INITIAL_PASSWORD=

# Optional comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the browser UI is same-origin. Never use * in production.
CORS_ORIGINS=

# 本地部署 CLI 专用 token（scripts/vercel-cli.mjs 读取；Vercel Account → Tokens 创建，
# 仅本地脚本消费，生产部署不需要此项）
VERCEL_TOKEN=
